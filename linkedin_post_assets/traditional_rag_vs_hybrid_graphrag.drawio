<mxfile host="app.diagrams.net" modified="2026-07-12T00:00:00.000Z" agent="LinkedInAssets" version="24.7.17"><diagram name="Traditional RAG vs Hybrid GraphRAG"><mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;1. Embed query&lt;/b&gt;&lt;br/&gt;Turn text into a vector" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontFamily=Segoe UI;fontSize=18;fontColor=#111827;spacing=14;fillColor=#F8FAFC;strokeColor=#D9E1EC;" vertex="1" parent="1"><mxGeometry x="115" y="310" width="410" height="105" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;2. Retrieve chunks&lt;/b&gt;&lt;br/&gt;Find similar documents" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontFamily=Segoe UI;fontSize=18;fontColor=#111827;spacing=14;fillColor=#ECFEFF;strokeColor=#D9E1EC;" vertex="1" parent="1"><mxGeometry x="115" y="485" width="410" height="105" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;3. Generate answer&lt;/b&gt;&lt;br/&gt;LLM writes from retrieved context" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontFamily=Segoe UI;fontSize=18;fontColor=#111827;spacing=14;fillColor=#F5F3FF;strokeColor=#D9E1EC;" vertex="1" parent="1"><mxGeometry x="115" y="660" width="410" height="105" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;Common limitation&lt;/b&gt;&lt;br/&gt;Relationships and policy boundaries can be implicit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontFamily=Segoe UI;fontSize=18;fontColor=#111827;spacing=14;fillColor=#F8FAFC;strokeColor=#D9E1EC;" vertex="1" parent="1"><mxGeometry x="115" y="835" width="410" height="105" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;1. Use memory&lt;/b&gt;&lt;br/&gt;Conversation-aware query handling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontFamily=Segoe UI;fontSize