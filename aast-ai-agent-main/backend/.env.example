# ============================================================
# AAST AI Agent - Backend Environment Variables
# ============================================================

INTERNAL_SECRET_KEY=replace-with-shared-internal-secret
ORCHESTRATOR_PORT=8004
DECISION_API_URL=http://127.0.0.1:8005

# Ollama / LLM resilience
OLLAMA_BASE_URL=http://localhost:11434
PRIMARY_MODEL=gemma4:e2b
BACKUP_MODEL=tinyllama:latest
PRIMARY_MAX_FAILURES=3
BACKUP_MAX_FAILURES=1
BREAKER_THRESHOLD=5
HALF_OPEN_INTERVAL_MS=30000
PRIMARY_RECOVERY_SUCCESSES=2
PRIMARY_RETRY_LIMIT=2
BACKUP_RETRY_LIMIT=1
PRIMARY_TIMEOUT_MS=12000
BACKUP_TIMEOUT_MS=10000
PRIMARY_COLD_START_TIMEOUT_MS=30000
MODEL_PRELOAD_TIMEOUT_MS=15000
LLM_REQUEST_DEADLINE_MS=22000
OLLAMA_RETRY_BASE_DELAY_MS=300
OLLAMA_RETRY_MAX_DELAY_MS=1200
OLLAMA_STARTUP_WAIT_ENABLED=true
OLLAMA_STARTUP_WAIT_TIMEOUT_MS=60000
OLLAMA_STARTUP_WAIT_INTERVAL_MS=2000
STARTUP_PRELOAD_ENABLED=true
PERIODIC_HEALTH_ENABLED=true
HEALTH_PROBE_INTERVAL_MS=30000
OLLAMA_KEEP_ALIVE=10m

# Gemma stabilization profile
GEMMA_MAX_CONTEXT_TOKENS=3500
GEMMA_CONTEXT_HEADROOM_TOKENS=192
GEMMA_HIGH_PRESSURE_CONTEXT_TOKENS=2800
GEMMA_DEFER_SYNTHESIS_TOKENS=3200
GEMMA_NUM_CTX=4096
GEMMA_MIN_NUM_CTX=512
GEMMA_NUM_THREAD=0
GEMMA_NUM_BATCH=0
GEMMA_MAX_ACTIVE_REQUESTS=1
GEMMA_QUEUE_MAX_DEPTH=24
GEMMA_QUEUE_TIMEOUT_MS=25000
GEMMA_TEMPERATURE=0.15
GEMMA_TOP_P=0.80
GEMMA_REPEAT_PENALTY=1.16
GEMMA_NUM_PREDICT_LIGHT=128
GEMMA_NUM_PREDICT_INTENT=96
GEMMA_NUM_PREDICT_SYNTHESIS=420
GEMMA_NUM_PREDICT_HEAVY=320
GEMMA_NUM_PREDICT_FALLBACK=220
GEMMA_NUM_PREDICT_MAX=512
GEMMA_MEMORY_HIGH_RSS_MB=6144
GEMMA_MEMORY_CRITICAL_RSS_MB=8192
GEMMA_OLLAMA_MEMORY_POLL_MS=30000
GEMMA_WARM_POOL_ENABLED=true
GEMMA_WARM_POOL_INTERVAL_MS=420000
GEMMA_WARM_POOL_TIMEOUT_MS=8000
GEMMA_WARM_POOL_INITIAL_DELAY_MS=45000
GEMMA_WARM_POOL_JITTER_MS=30000
GEMMA_WARM_POOL_SKIP_QUEUE_BUSY=true
GEMMA_WARM_POOL_SKIP_MEMORY_HIGH=true
GEMMA_WARM_POOL_PROMPT=.
MODEL_PRELOAD_STAGGER_MS=5000
MODEL_WARM_PROBE_TIMEOUT_MS=8000
OLLAMA_OVERLOAD_RETRY_DELAY_MS=250
OLLAMA_RECOVERY_RETRY_DELAY_MS=1200
OLLAMA_RECOVERY_RETRY_MAX_DELAY_MS=5000

# Lightweight academic query normalization
QUERY_NORMALIZER_FUZZY=true
QUERY_NORMALIZER_MAX_CHARS=600

# Routing precision calibration
KG_CONFIDENCE_THRESHOLD=0.40
HYBRID_CONFIDENCE_THRESHOLD=0.34
LLM_FALLBACK_THRESHOLD=0.18
PERSON_ALIAS_BOOST=0.22
REQUIREMENTS_HYBRID_BOOST=0.26
SCHOLARSHIP_HYBRID_BOOST=0.34
ROUTE_AMBIGUITY_MARGIN=0.12
ROUTE_HISTORY_BOOST=0.06
DETERMINISTIC_KG_THRESHOLD=0.70
DETERMINISTIC_RAG_THRESHOLD=0.70

# RAG Service Configuration
RAG_BASE_URL=http://127.0.0.1:8001
RAG_RETRIEVER_PATH=/search
RAG_ANSWER_PATH=/answer
RAG_EMBEDDING_INIT_MODE=lazy
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBED_BATCH_SIZE=4
RAG_INGEST_BATCH_SIZE=8
RAG_TORCH_NUM_THREADS=1
RAG_LOW_CPU_MEM_USAGE=true
RAG_EMBEDDING_DYNAMIC_QUANTIZE=false
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# Decision voice subsystem
VOICE_ENABLED=true
VOICE_WHISPER_MODEL=base
VOICE_DEVICE=cpu
VOICE_TEMP_DIR=.
VOICE_MAX_UPLOAD_MB=25
VOICE_FFMPEG_LOCAL_COPY=false

# Frontend / Node local memory
NODE_OPTIONS=--max-old-space-size=4096

# Neo4j connection settings
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j
