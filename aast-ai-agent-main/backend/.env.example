# Standalone Advisor API configuration only. Docker Compose uses the root .env.
NODE_ENV=development
ORCHESTRATOR_PORT=8004
INTERNAL_SECRET_KEY=replace-with-a-random-service-secret
AUTH_JWT_SECRET=replace-with-a-different-random-jwt-secret
AUTH_USERS_JSON=[]
AUTH_GUEST_ENABLED=true

DECISION_API_URL=http://127.0.0.1:8005
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-the-neo4j-password
NEO4J_DATABASE=neo4j
RAG_BASE_URL=http://127.0.0.1:8001
RAG_RETRIEVER_URL=http://127.0.0.1:8001
RAG_ANSWER_URL=http://127.0.0.1:8002
OLLAMA_BASE_URL=http://127.0.0.1:11434
PRIMARY_MODEL=gemma4:e2b
KG_EMBED_MODEL=nomic-embed-text

SINGLE_GEMMA_GENERATION_MODE=true
GEMINI_BACKUP_ENABLED=false
RAG_ANSWER_ENGINE_ENABLED=false
ROUTING_AUDIT_ENABLED=true
LOG_LEVEL=INFO
LOG_DIR=logs

# Required shared services must point to the same isolated stack as this process.
BACKUP_MODEL=tinyllama:latest
# Optional when the Gemini integration is explicitly enabled.
GEMINI_API_KEY=replace-only-if-using-gemini
