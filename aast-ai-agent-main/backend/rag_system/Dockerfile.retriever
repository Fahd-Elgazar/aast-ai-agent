FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TOKENIZERS_PARALLELISM=false

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.retriever.txt .
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.3.1+cpu \
    && pip install --no-cache-dir -r requirements.retriever.txt

COPY phase3_retriever.py phase2_qdrant_ingestion.py cleaned_chunked_cai_production_v4.json ./

EXPOSE 8001

CMD ["uvicorn", "phase3_retriever:app", "--host", "0.0.0.0", "--port", "8001"]
