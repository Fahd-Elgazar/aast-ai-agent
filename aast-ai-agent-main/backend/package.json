{
  "name": "aast-backend-combined",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=3072 scripts/startOrchestrator.js",
    "start:container": "node --max-old-space-size=3072 scripts/startOrchestrator.js",
    "start:orchestrator": "node --max-old-space-size=3072 scripts/startOrchestrator.js",
    "start:orchestrator:direct": "node --max-old-space-size=3072 orchestrator.js",
    "dev": "nodemon --exec \"node --max-old-space-size=3072\" orchestrator.js",
    "dev:orchestrator": "nodemon --exec \"node --max-old-space-size=3072\" orchestrator.js",
    "test:health": "node testing/healthFreshness.test.js && node testing/healthReadiness.test.js",
    "test:kg": "node testing/kgReliability.test.js",
    "test:topology": "node testing/runtimeTopology.test.js",
    "test:auth": "node testing/authIsolation.test.js",
    "test:auth-provisioning": "node testing/competitionUserProvisioning.test.js",
    "test:admin-proxy": "node testing/adminProxyIntegration.test.js",
    "test:golden-cache": "node testing/goldenCachePolicy.test.js",
    "test:routing": "node testing/routingPrecisionCalibration.test.js",
    "test:decision": "node testing/decisionTruth.test.js",
    "verify:kg-readiness": "node scripts/verifyKgEmbeddingReadiness.js",
    "auth:generate-user": "node scripts/generateAuthUser.js",
    "auth:provision-students": "node scripts/provisionCompetitionUsers.js",
    "benchmark:golden": "node testing/goldenPathBenchmark.js",
    "prewarm:golden": "node testing/prewarmGoldenQueries.js"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "body-parser": "^1.20.6",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "neo4j-driver": "^5.9.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "description": "Evidence-grounded academic advising orchestrator with Neo4j, Qdrant RAG, and decision support.",
  "main": "orchestrator.js",
  "keywords": [
    "rag",
    "neo4j",
    "academic-advising"
  ],
  "author": "AAST AI Agent Team",
  "license": "ISC"
}
