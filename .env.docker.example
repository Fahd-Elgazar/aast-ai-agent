# Copy this file to .env and replace every required placeholder before starting.
# Never commit the resulting .env file.

INTERNAL_SECRET_KEY=replace-with-a-long-random-secret

NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-password
NEO4J_DATABASE=neo4j
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

# Ollama runs on the Docker host by default.
OLLAMA_BASE_URL=http://host.docker.internal:11434
RAG_ANSWER_MODEL=gemma4:e2b

NODE_OPTIONS=--max-old-space-size=4096

RAG_EMBEDDING_INIT_MODE=eager
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBED_BATCH_SIZE=4
RAG_TORCH_NUM_THREADS=4
RAG_HEALTH_REQUIRES_EMBEDDING=true
RAG_LOW_CPU_MEM_USAGE=true
RAG_EMBEDDING_DYNAMIC_QUANTIZE=false
