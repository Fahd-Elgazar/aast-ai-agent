# Docker Compose host-side defaults.
# Copy to .env if you want Compose variable substitution without touching app .env files.

INTERNAL_SECRET_KEY=aast-internal-secret-2024

NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

# Ollama stays on the Windows host in phase 1.
OLLAMA_BASE_URL=http://host.docker.internal:11434
RAG_ANSWER_MODEL=tinyllama

NODE_OPTIONS=--max-old-space-size=4096

RAG_EMBEDDING_INIT_MODE=lazy
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBED_BATCH_SIZE=4
RAG_TORCH_NUM_THREADS=1
RAG_LOW_CPU_MEM_USAGE=true
RAG_EMBEDDING_DYNAMIC_QUANTIZE=false
