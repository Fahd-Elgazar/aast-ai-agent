# Root Docker Compose configuration authority. Copy to .env and replace every
# replace-with-* value before starting the stack.
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-random-neo4j-password
NEO4J_DATABASE=neo4j
INTERNAL_SECRET_KEY=replace-with-a-random-service-secret
AUTH_JWT_SECRET=replace-with-a-different-random-jwt-secret
AUTH_USERS_JSON=[]
AUTH_GUEST_ENABLED=true

# Host Ollama and model contract.
OLLAMA_BASE_URL=http://host.docker.internal:11434
PRIMARY_MODEL=gemma4:e2b
KG_EMBED_MODEL=nomic-embed-text
SINGLE_GEMMA_GENERATION_MODE=true
GEMINI_BACKUP_ENABLED=false

# RAG/Qdrant contract. The official corpus is supplied separately through the
# RAG private-corpus preflight/ingestion workflow; it is never committed here.
RAG_COLLECTION_NAME=aast_academic_rag_production
RAG_EMBEDDING_INIT_MODE=eager
RAG_EMBEDDING_DEVICE=cpu
RAG_TORCH_NUM_THREADS=4
RAG_SYNTHETIC_PROBES_ENABLED=false

# Conservative local resource defaults.
NODE_OPTIONS=--max-old-space-size=4096
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
