# Standalone Decision API configuration only. Docker Compose uses the root .env.
HOST=127.0.0.1
PORT=8005
DATABASE_URL=sqlite:///./dev.db
INTERNAL_SECRET_KEY=replace-with-the-same-service-secret-used-by-the-advisor-api
AUTH_JWT_SECRET=replace-with-the-same-jwt-secret-used-by-the-advisor-api
VOICE_ENABLED=false
VOICE_TEMP_DIR=./runtime/voice
