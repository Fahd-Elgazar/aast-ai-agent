{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aast-ai-agent/contracts/retrieval/entity-evidence.schema.json",
  "title": "Entity Evidence",
  "description": "Deterministic exact-retrieval evidence emitted by CLA-WOW-001. Each evidence object carries normalized subject/relation/object, entity types, and a stable evidence id so exact identity and alignment data can be consumed by later protected integrations.",
  "type": "object",
  "additionalProperties": true,
  "required": ["evidence_id", "subject", "relation", "object", "entity_types", "normalized", "source"],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable, deterministic identifier: `${source}:${normalizedSubject}|${normalizedRelation}|${normalizedObject}`."
    },
    "subject": { "$ref": "#/definitions/entityRef" },
    "object": { "$ref": "#/definitions/entityRef" },
    "relation": {
      "type": ["string", "null"],
      "description": "Raw graph relationship type (e.g. TEACHES, HAS_PREREQUISITE), or null for identity-only evidence."
    },
    "entity_types": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "object"],
      "properties": {
        "subject": { "type": ["string", "null"] },
        "object": { "type": ["string", "null"] }
      }
    },
    "normalized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "relation", "object"],
      "properties": {
        "subject": { "type": "string" },
        "relation": { "type": "string" },
        "object": { "type": "string" }
      }
    },
    "source": {
      "type": "string",
      "enum": ["exact", "vector"],
      "description": "Retrieval origin. Exact identity matches are `exact`; bounded semantic fallback is `vector`."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "definitions": {
    "entityRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": ["string", "null"], "description": "Canonical graph node id when available." },
        "name": { "type": ["string", "null"] },
        "type": { "type": ["string", "null"], "description": "Entity type / node label." }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aligned", "reason"],
      "description": "Verdict produced by alignEvidenceToTarget for a requested exact target.",
      "properties": {
        "aligned": { "type": "boolean" },
        "reason": {
          "type": "string",
          "enum": ["OK", "TARGET_ABSENT", "RELATION_MISMATCH", "MISSING_INPUT"]
        },
        "matched_role": { "type": ["string", "null"], "enum": ["subject", "object", null] }
      }
    }
  }
}
